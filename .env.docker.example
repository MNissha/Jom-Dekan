# Optional overrides used by docker-compose.yml for local development.
# Copy this file to .env. Never commit the resulting .env file.

FRONTEND_PORT=5173
BACKEND_PORT=3000

# Generate unique random values instead of using the Compose development defaults.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
COOKIE_SECRET=replace-with-a-random-cookie-secret
STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Backend-only. Leave blank to run without live AI requests.
OPENAI_API_KEY=
AI_SUMMARY_ENABLED=true
AI_AGENT_ENABLED=true
