# =====================================================================
# JomDekan backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins. No wildcards.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jomdekan
DB_SSL=false
DB_POOL_MAX=20

# --- JWT / sessions ------------------------------------------------------
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# HTTP-only cookie name that carries the refresh token
REFRESH_COOKIE_NAME=jomdekan_rt
COOKIE_SECRET=change-me-cookie-signing-secret

# --- Object storage (Milestone 3) ---------------------------------------
# local-fs: real local-disk storage, used for dev (no cloud account
# needed) — files live under STORAGE_LOCAL_ROOT, served through
# signed-token routes, never a public path. Switch to s3/supabase in
# production once real cloud credentials exist.
STORAGE_PROVIDER=local-fs
STORAGE_BUCKET=jomdekan-resources
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_ROOT=./storage/resources
# Generate a strong random value, e.g. `openssl rand -hex 32`
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret-min-32-chars

# --- Resource uploads (Milestone 3) --------------------------------------
RESOURCE_MAX_FILE_SIZE_BYTES=20971520
RESOURCE_UPLOAD_TOKEN_TTL_SECONDS=300
RESOURCE_DOWNLOAD_TOKEN_TTL_SECONDS=300

# --- Redis / BullMQ (introduced when background jobs are needed) --------
REDIS_URL=redis://localhost:6379

# --- Email (queued adapter; Milestone 6) ---------------------------------
# console: logs the "email" to this terminal instead of sending it (default).
# smtp: sends for real via any SMTP server. For Gmail: host=smtp.gmail.com,
# port=587 (465 is blocked on some networks), and SMTP_USER/SMTP_PASSWORD
# are your Gmail address and a 16-character "App Password" (Google Account
# -> Security -> 2-Step Verification -> App passwords) — NOT your normal
# Gmail login password.
# resend: sends over HTTPS via the Resend API (resend.com) instead of raw
# SMTP — avoids SMTP ports being blocked/flaky on some networks. Needs
# only RESEND_API_KEY; EMAIL_FROM must be onboarding@resend.dev unless
# you've verified your own sending domain with Resend.
# sendgrid: also sends over HTTPS (sendgrid.com). Unlike Resend's sandbox,
# SendGrid's free "Single Sender Verification" only requires proving you
# own EMAIL_FROM's inbox (click a confirmation link) — no domain needed —
# and can then deliver to any recipient. Needs only SENDGRID_API_KEY.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@jomdekan.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- Google OAuth (added after password auth is stable) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20

# --- AI resource summaries (Phase 1) -------------------------------------
# Backend-only. Never prefix with VITE_, never log, never return in an API
# response. Leave OPENAI_API_KEY blank to keep AI summaries effectively
# unusable in dev; set AI_SUMMARY_ENABLED=false to disable the feature
# outright regardless of whether a key is configured.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
# A full structured summary (up to 8 study sections, 12 glossary
# entries, etc.) for a real multi-page document routinely needs more
# than 1000 output tokens once the model's own reasoning-token overhead
# is included — too low a value here gets the JSON cut off mid-response
# ("the model returned a response that could not be parsed").
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=4000
AI_SUMMARY_ENABLED=true
# Extracted document text longer than this is truncated before it is sent
# to OpenAI (cost control) — see resourceTextExtractionService.
AI_SUMMARY_MAX_INPUT_CHARACTERS=80000
# Per-user cap on how many *new* generations (cache hits don't count) are
# allowed per rolling calendar day.
AI_SUMMARY_DAILY_USER_LIMIT=10
# Images larger than this (bytes, original upload size) are rejected
# before ever being sent to OpenAI.
AI_SUMMARY_MAX_IMAGE_SIZE_BYTES=5242880

# --- "Ask This Resource" agent (Phase 2) ---------------------------------
# Reuses OPENAI_API_KEY above — never a second key/client. Leave
# OPENAI_AGENT_MODEL blank to reuse OPENAI_SUMMARY_MODEL.
AI_AGENT_ENABLED=true
OPENAI_AGENT_MODEL=
AI_AGENT_MAX_OUTPUT_TOKENS=600
# At most this many read-only tool calls (search/read) per question.
AI_AGENT_MAX_TOOL_CALLS=2
# At most this many chunks returned per search_current_resource call.
AI_AGENT_MAX_CHUNKS_PER_SEARCH=5
# Each returned/read chunk is capped to this many characters.
AI_AGENT_MAX_CHUNK_CHARACTERS=1500
# How many recent question/answer pairs are resent as context.
AI_AGENT_CONTEXT_TURNS=4
# Per-user cap on new agent questions per rolling calendar day (cache
# hits don't count).
AI_AGENT_DAILY_USER_LIMIT=10
# Per-session cap on total stored messages (user + assistant combined).
AI_AGENT_SESSION_MESSAGE_LIMIT=30
AI_AGENT_MAX_QUESTION_CHARACTERS=1000
# How long an idle session stays ACTIVE before it's treated as expired.
AI_AGENT_SESSION_EXPIRY_DAYS=30
